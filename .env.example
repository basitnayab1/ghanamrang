# Copy to .env.local and set real values
# Password for /admin (orders page)
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin login cookie
ADMIN_SECRET=change-me-to-a-long-random-string

# Order storage (Upstash Redis). On Vercel, connecting "Upstash for Redis"
# under Storage sets these for you. Leave unset locally to use .data/orders.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
